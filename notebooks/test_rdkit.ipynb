    "import marimo as mo\n",
    "from rdkit import Chem\n",
    "from rdkit.Chem import Descriptors\n",
    "\n",
    "mol = Chem.MolFromSmiles(\"CCO\")\n",
    "f\"\"\"\n",
    "# RDKit in marimo + Molab\n",
    "\n",
    "SMILES: `CCO`\n",
    "\n",
    "Molecular weight: `{Descriptors.MolWt(mol):.2f}`\n",
    "\"\"\""
   ]
